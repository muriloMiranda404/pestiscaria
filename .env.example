# Node 24. Production is the default. Use demo only on an isolated preview with writable disk.
APP_MODE=production
# Define the final HTTPS origin before printing permanent QR codes.
NEXT_PUBLIC_SITE_URL=
# Opt in to indexing only after owner approval, on the production deployment.
SITE_INDEXABLE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, required for enabled anonymous metrics/reservations and distributed login quotas.
SUPABASE_SERVICE_ROLE_KEY=
# Only set when your reverse proxy overwrites and validates this request header.
TRUSTED_CLIENT_IP_HEADER=
# Demo storage, never share its volume with production.
DEMO_DB_PATH=.local/demo.sqlite
